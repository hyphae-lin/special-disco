{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": false,
			"palette": [
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#F1E9D8"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1B1714"
				},
				{
					"slug": "oxblood",
					"name": "Oxblood",
					"color": "#6E1B17"
				},
				{
					"slug": "muted-ink",
					"name": "Muted ink",
					"color": "#4A3F37"
				},
				{
					"slug": "band",
					"name": "Band",
					"color": "#EAE0CB"
				},
				{
					"slug": "card",
					"name": "Card",
					"color": "#F6F0E3"
				},
				{
					"slug": "hatch",
					"name": "Hatch",
					"color": "#E6DCC6"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "fell-sc",
					"name": "IM Fell English SC",
					"fontFamily": "\"IM Fell English SC\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "IM Fell English SC",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/im-fell-english-sc-latin-400-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "fell",
					"name": "IM Fell English",
					"fontFamily": "\"IM Fell English\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "IM Fell English",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/im-fell-english-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "IM Fell English",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/im-fell-english-latin-400-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "caslon",
					"name": "Libre Caslon Text",
					"fontFamily": "\"Libre Caslon Text\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Libre Caslon Text",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/libre-caslon-text-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Libre Caslon Text",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/libre-caslon-text-latin-400-italic.woff2"
							]
						},
						{
							"fontFamily": "Libre Caslon Text",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/libre-caslon-text-latin-700-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.125rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.75rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3.5rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					}
				},
				{
					"slug": "masthead",
					"name": "Masthead",
					"size": "8.25rem",
					"fluid": {
						"min": "3.5rem",
						"max": "8.25rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Tiny",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "Small",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "Medium",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "Large",
					"size": "clamp(2rem, 4vw, 3.5rem)"
				},
				{
					"slug": "60",
					"name": "Section",
					"size": "clamp(2.5rem, 6vw, 4.5rem)"
				}
			]
		},
		"border": {
			"radius": false
		},
		"shadow": {
			"defaultPresets": false
		},
		"custom": {
			"rule": {
				"thin": "1px solid var(--wp--preset--color--ink)",
				"double": "4px double var(--wp--preset--color--ink)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--caslon)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"left": "1rem",
				"right": "1rem"
			},
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--oxblood)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--oxblood)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fell-sc)",
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "0.04em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontFamily": "var(--wp--preset--font-family--fell)",
					"letterSpacing": "0"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"letterSpacing": "0.08em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--oxblood)",
					"text": "var(--wp--preset--color--paper)"
				},
				"border": {
					"radius": "0",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.625rem",
						"right": "1.625rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fell-sc)",
					"fontSize": "1.125rem",
					"letterSpacing": "0.06em",
					"lineHeight": "1.4"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--ink)",
						"text": "var(--wp--preset--color--paper)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--oxblood)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted-ink)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "italic"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fell-sc)",
					"fontWeight": "400",
					"letterSpacing": "0.04em",
					"lineHeight": "0.9"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fell)",
					"fontStyle": "italic",
					"fontSize": "1.1875rem"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fell-sc)",
					"fontSize": "0.9375rem",
					"letterSpacing": "0.08em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"width": "0"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--oxblood)",
						"width": "2px",
						"style": "solid"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fell)",
					"fontStyle": "italic",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fell)",
					"fontStyle": "italic"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--ink)"
						},
						"border": {
							"width": "1.5px",
							"style": "solid",
							"color": "var(--wp--preset--color--ink)",
							"radius": "0"
						},
						"spacing": {
							"padding": {
								"top": "0.625rem",
								"bottom": "0.625rem",
								"left": "1rem",
								"right": "1rem"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Page, full width",
			"postTypes": [
				"page"
			]
		}
	]
}
